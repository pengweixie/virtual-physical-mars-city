data/
__pycache__/
*.pyc
node_modules/
# models/: 大文件(GLB/贴图/归档)不入库,但 manifest 与知识卡必须入库
models/**
!models/*/
models/_archive/
models/_inbox/
!models/manifest.json
!models/**/info.json

# local machine config - never published (packaging rule 4)
.claude/settings.local.json

# commercial-tool project files - kept locally, never published (packaging rule 1)
comsol/*.mph
comsol/*.java
comsol/*.class
comsol/*.class.*
comsol/*.log
**/comsol/*.java
**/comsol/*.mph

# audio masters (WAV) stay local; the viewer ships the transcoded m4a
music/
